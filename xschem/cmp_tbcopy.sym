v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -50 -6 0 0 0.3 0.3 {}
T {@name} 135 -62 0 0 0.2 0.2 {}
P 4 5 130 -50 -130 -50 -130 50 130 50 130 -50 {}
B 5 -152.5 -32.5 -147.5 -27.5 {name=vthr dir=in}
L 7 -150 -30 -130 -30 {}
T {vthr} -125 -34 0 0 0.2 0.2 {}
B 5 -152.5 -12.5 -147.5 -7.5 {name=vcap dir=in}
L 7 -150 -10 -130 -10 {}
T {vcap} -125 -14 0 0 0.2 0.2 {}
B 5 -152.5 27.5 -147.5 32.5 {name=nb dir=inout}
L 7 -150 30 -130 30 {}
T {nb} -125 26 0 0 0.2 0.2 {}
B 5 147.5 -32.5 152.5 -27.5 {name=VDPWR dir=inout}
L 7 130 -30 150 -30 {}
T {VDPWR} 125 -34 0 1 0.2 0.2 {}
B 5 147.5 -2.5 152.5 2.5 {name=cmp_raw dir=out}
L 7 130 0 150 0 {}
T {cmp_raw} 125 -4 0 1 0.2 0.2 {}
B 5 147.5 27.5 152.5 32.5 {name=VGND dir=inout}
L 7 130 30 150 30 {}
T {VGND} 125 26 0 1 0.2 0.2 {}
