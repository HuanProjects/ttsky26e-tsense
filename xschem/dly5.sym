P 4 5 70 -40 -70 -40 -70 40 70 40 70 -40 {}
B 5 -92.5 -2.5 -87.5 2.5 {name=a dir=in}
L 7 -90 0 -70 0 {}
T {a} -65 -4 0 0 0.2 0.2 {}
B 5 87.5 -2.5 92.5 2.5 {name=y dir=out}
L 7 70 0 90 0 {}
T {y} 65 -4 0 1 0.2 0.2 {}
B 5 -2.5 -62.5 2.5 -57.5 {name=VDPWR dir=inout}
L 7 0 -60 0 -40 {}
T {VDPWR} 4 -36 0 0 0.2 0.2 {}
B 5 -2.5 57.5 2.5 62.5 {name=VGND dir=inout}
L 7 0 40 0 60 {}
T {VGND} 4 26 0 0 0.2 0.2 {}
