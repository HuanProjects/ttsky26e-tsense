v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -40 -6 0 0 0.3 0.3 {}
T {@name} 135 -72 0 0 0.2 0.2 {}
P 4 5 130 -60 -130 -60 -130 60 130 60 130 -60 {}
B 5 -152.5 -42.5 -147.5 -37.5 {name=vthr dir=in}
L 7 -150 -40 -130 -40 {}
T {vthr} -125 -44 0 0 0.2 0.2 {}
B 5 -152.5 -22.5 -147.5 -17.5 {name=vcap dir=in}
L 7 -150 -20 -130 -20 {}
T {vcap} -125 -24 0 0 0.2 0.2 {}
B 5 -152.5 17.5 -147.5 22.5 {name=ib_cmp1 dir=inout}
L 7 -150 20 -130 20 {}
T {ib_cmp1 (tail)} -125 16 0 0 0.2 0.2 {}
B 5 -152.5 37.5 -147.5 42.5 {name=ib_cmp2 dir=inout}
L 7 -150 40 -130 40 {}
T {ib_cmp2 (n2)} -125 36 0 0 0.2 0.2 {}
B 5 147.5 -42.5 152.5 -37.5 {name=VDPWR dir=inout}
L 7 130 -40 150 -40 {}
T {VDPWR} 125 -44 0 1 0.2 0.2 {}
B 5 147.5 -2.5 152.5 2.5 {name=cmp_raw dir=out}
L 7 130 0 150 0 {}
T {cmp_raw} 125 -4 0 1 0.2 0.2 {}
B 5 147.5 37.5 152.5 42.5 {name=VGND dir=inout}
L 7 130 40 150 40 {}
T {VGND} 125 36 0 1 0.2 0.2 {}
