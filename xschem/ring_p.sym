v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -60 -6 0 0 0.3 0.3 {}
T {@name} 135 -12 0 0 0.2 0.2 {}
P 4 5 130 0 -130 0 -130 80 130 80 130 0 {}
B 5 -152.5 17.5 -147.5 22.5 {name=en dir=in}
L 7 -150 20 -130 20 {}
T {en} -125 16 0 0 0.2 0.2 {}
B 5 147.5 17.5 152.5 22.5 {name=out dir=out}
L 7 130 20 150 20 {}
T {out} 125 16 0 1 0.2 0.2 {}
B 5 147.5 37.5 152.5 42.5 {name=VDPWR dir=inout}
L 7 130 40 150 40 {}
T {VDPWR} 125 36 0 1 0.2 0.2 {}
B 5 147.5 57.5 152.5 62.5 {name=VGND dir=inout}
L 7 130 60 150 60 {}
T {VGND} 125 56 0 1 0.2 0.2 {}
